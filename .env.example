# Frontend: API base used by client-side fetch requests
# Keep as /api in local dev to use Vite proxy.
VITE_API_URL=/api

# Frontend dev server: backend target for Vite proxy.
VITE_BACKEND_URL=http://localhost:3001

# Backend server port
PORT=3001

# Backend CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Vercel KV REST credentials (added automatically when you connect a KV store
# to the Vercel project). Required in production because serverless disks reset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_STATE_KEY=crickethub:state

# Cloudinary (server-side only). All new player, logo, sponsor, and banner
# uploads are stored as secure Cloudinary URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
